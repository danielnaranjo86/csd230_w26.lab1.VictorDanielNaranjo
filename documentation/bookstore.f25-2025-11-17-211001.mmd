classDiagram

%% ===== Interfaces =====
    class SaleableItem {
        <<interface>>
        +sellItem()
        +getPrice()
    }

    class Serializable {
        <<interface>>
    }

%% ===== Core Product Hierarchy =====
    class ProductEntity {
        <<abstract>>
        -Long id
    }

    ProductEntity ..|> SaleableItem
    ProductEntity ..|> Serializable

    class PublicationEntity {
        <<abstract>>
        -String title
        -double pubPrice
        -int copies
        +getPrice()
    }

    ProductEntity <|-- PublicationEntity

    class BookEntity {
        -String author
    }

    PublicationEntity <|-- BookEntity

    class MagazineEntity {
        -int orderQty
        -LocalDateTime currentIssue
    }

    PublicationEntity <|-- MagazineEntity

    class DiscMagEntity {
        -boolean hasDisc
    }

    MagazineEntity <|-- DiscMagEntity

    class TicketEntity {
        -String description
        -double ticketPrice
        +sellItem()
    }

    ProductEntity <|-- TicketEntity

%% ===== Cart (Many-to-Many) =====
    class CartEntity {
        -Long id
    }

    CartEntity "*" -- "*" ProductEntity : contains

%% ===== Niche: Musical Instruments =====
    class InstrumentEntity {
        <<abstract>>
        -String brand
        -String model
    }

    ProductEntity <|-- InstrumentEntity

    class GuitarEntity {
        -int numberOfStrings
        -boolean electric
    }

    InstrumentEntity <|-- GuitarEntity

    class DrumKitEntity {
        -int numberOfDrums
        -boolean acoustic
    }

    InstrumentEntity <|-- DrumKitEntity
